# ============================================================
# 花小满 AI Agent - 环境变量模板
# 用法：cp .env.example .env 然后填入你自己的值
# ============================================================

# 阿里云百炼 API Key（去 https://dashscope.aliyun.com 申请）
OPENAI_API_KEY=sk-your-dashscope-api-key-here

# 百炼 OpenAI 兼容接口地址（固定值，不用改）
BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 使用的模型（qwen-plus / qwen-turbo / qwen-max 均可）
MODEL=qwen-plus

# MySQL 连接（和 docker-compose.yml 里的密码保持一致）
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=change_me_to_your_password
MYSQL_DB=flower_cloud
MYSQL_SHOP_DB=flower_shop_db

# Neo4j 知识图谱（和 docker-compose.yml 里的密码保持一致）
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change_me_to_your_password

# Redis 短期记忆
REDIS_URL=redis://localhost:6379

# 用户身份验证密钥（PHP 端用同样的 secret 生成 token）
# 随便写一串足够长的随机字符串
AUTH_SECRET=change_me_to_a_random_string
